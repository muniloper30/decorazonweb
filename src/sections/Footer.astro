---
import Image from "astro/components/Image.astro";
import Logo from "../assets/logoDcorazon.png";
---

<footer class="shadow-sm bg-tertiary mt-2">
  <div class="w-full max-w-screen-xl mx-auto p-4 md:py-8">
    <div class="flex flex-col items-center sm:flex-row sm:items-center sm:justify-between text-center sm:text-left">
      <a
        href="#header"
        class="flex flex-col sm:flex-row items-center mb-4 sm:mb-0 space-x-0 sm:space-x-3 rtl:space-x-reverse"
      >
        <Image
          class="h-auto w-24 md:w-[150px] mb-2 sm:mb-0"
          src={Logo}
          alt="Logo Decorazon"
        />
        <span
          class="self-center text-2xl font-semibold whitespace-nowrap text-neutral-800/80"
          >DeCorazón</span
        >
      </a>

      <ul
        class="flex flex-wrap justify-center items-center mb-6 text-sm font-medium text-neutral-800/80 sm:mb-0"
      >
        <li><a href="#" class="hover:underline me-4 md:me-6">Inicio</a></li>
        <li><a href="/Gallery" class="hover:underline me-4 md:me-6">Galería</a></li>
        <li><a href="/#services" class="hover:underline me-4 md:me-6">Servicios</a></li>
        <li><a href="/#Contact" class="hover:underline me-4 md:me-6">Contacto</a></li>
        <li><a href="/Form" class="hover:underline ms-4 md:ms-6">Solicitar presupuesto</a></li>
      </ul>
    </div>

    <hr class="my-6 border-gray-200 sm:mx-auto dark:border-gray-700 lg:my-8" />

    <span class="block text-sm text-gray-600 text-center mt-4">
      © 2025 <a href="#header" class="hover:underline font-medium hover:text-gray-800">DeCorazón™</a>.
      All Rights Reserved.
    </span>
    <span class="block text-sm text-gray-600 text-center mt-4">Design <a href="https://portfolio-gta.vercel.app/" target="_blank" class="hover:underline font-medium hover:text-gray-800">muniloper30 by Víctor Lorencio</a></span>
  </div>
</footer>
