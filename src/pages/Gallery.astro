</Layout>

<script>
  function bindGallery() {
    const root = document.getElementById("gallery");
    if (!root) return;

    // Crear objetos separados para cada categoría
    const galleries = {
      general: Array.from(root.querySelectorAll("li img[data-category='general']")),
      bottles: Array.from(root.querySelectorAll("li img[data-category='bottles']")),
      potatoes: Array.from(root.querySelectorAll("li img[data-category='potatoes']")),
      signs: Array.from(root.querySelectorAll("li img[data-category='signs']")),
      nutellas: Array.from(root.querySelectorAll("li img[data-category='nutellas']")),
      chocolates: Array.from(root.querySelectorAll("li img[data-category='chocolates']")),
      cans: Array.from(root.querySelectorAll("li img[data-category='cans']"))
    };

    const lightBox = document.getElementById("lightbox");
    const lightBoxImgContainer = document.getElementById("light-box-content");
    const btnCloseLightBox = document.getElementById("close-lightbox");
    const btnPrev = document.getElementById("prev-image");
    const btnNext = document.getElementById("next-image");
    
    // Obtener todos los sliders mobile
    const sliders = [
      document.getElementById("slider-mobile"),
      document.getElementById("bottles-slider-mobile"),
      document.getElementById("potatoes-slider-mobile"),
      document.getElementById("signs-slider-mobile"),
      document.getElementById("nutellas-slider-mobile"),
      document.getElementById("chocolates-slider-mobile"),
      document.getElementById("cans-slider-mobile")
    ].filter(Boolean);

    let currentIndex = 0;
    let currentCategory = 'general';

    const openLightBox = (index, category) => {
      const categoryGallery = galleries[category];
      if (index < 0 || index >= categoryGallery.length) return;
      
      currentIndex = index;
      currentCategory = category;
      const image = categoryGallery[index];

      const previousImage = lightBoxImgContainer.querySelector("img");
      if (previousImage) {
        const galleryParentID = previousImage.getAttribute("data-thumbID");
        const galleryParent = document.getElementById(galleryParentID);
        if (galleryParent) galleryParent.appendChild(previousImage);
      }

      // Reset view transition names
      Object.values(galleries).flat().forEach((img) => (img.style.viewTransitionName = "none"));
      image.style.viewTransitionName = "selected-img";

      lightBoxImgContainer.appendChild(image);
      lightBox.classList.remove("opacity-0", "pointer-events-none");
      lightBox.classList.add(
        "bg-[#de96a1]",
        "z-[9999]",
        "opacity-100",
        "pointer-events-auto",
        "backdrop-blur-[10px]"
      );
      document.body.style.overflow = "hidden";
      updateNavigationButtons();
    };

    const closeLightBox = (image) => {
      lightBox.classList.add("opacity-0", "pointer-events-none");
      lightBox.classList.remove(
        "bg-[#de96a1]",
        "z-[9999]",
        "opacity-100",
        "pointer-events-auto",
        "backdrop-blur-[10px]"
      );
      const galleryParentID = image.getAttribute("data-thumbID");
      const galleryParent = document.getElementById(galleryParentID);
      if (galleryParent) galleryParent.appendChild(image);
      document.body.style.overflow = "";
    };

    const navigateLightBox = (direction) => {
      const categoryGallery = galleries[currentCategory];
      const newIndex = currentIndex + direction;
      if (newIndex < 0 || newIndex >= categoryGallery.length) return;
      
      if (!document.startViewTransition) {
        openLightBox(newIndex, currentCategory);
        return;
      }
      document.startViewTransition(() => openLightBox(newIndex, currentCategory));
    };

    const updateNavigationButtons = () => {
      if (!btnPrev || !btnNext) return;
      const categoryGallery = galleries[currentCategory];
      btnPrev.style.display = currentIndex > 0 ? "flex" : "none";
      btnNext.style.display = currentIndex < categoryGallery.length - 1 ? "flex" : "none";
    };

    // Event listeners para todas las categorías
    Object.entries(galleries).forEach(([category, images]) => {
      images.forEach((image, index) => {
        image.addEventListener("click", () => {
          if (!document.startViewTransition) {
            openLightBox(index, category);
            return;
          }
          Object.values(galleries).flat().forEach((img) => (img.style.viewTransitionName = ""));
          image.style.viewTransitionName = "selected-img";
          document.startViewTransition(() => openLightBox(index, category));
        });
      });
    });

    // Cerrar
    const handleClose = async () => {
      const image = lightBoxImgContainer.querySelector("img");
      if (!image) return;
      if (!document.startViewTransition) {
        closeLightBox(image);
        return;
      }
      const animation = document.startViewTransition(() =>
        closeLightBox(image)
      );
      await animation.finished;
      image.style.viewTransitionName = "none";
    };

    lightBox.addEventListener("click", handleClose);
    btnCloseLightBox?.addEventListener("click", (e) => {
      e.stopPropagation();
      handleClose();
    });
    btnPrev?.addEventListener("click", (e) => {
      e.stopPropagation();
      navigateLightBox(-1);
    });
    btnNext?.addEventListener("click", (e) => {
      e.stopPropagation();
      navigateLightBox(1);
    });

    document.addEventListener("keydown", async (event) => {
      const isLightboxOpen = !lightBox.classList.contains("opacity-0");
      if (event.key === "Escape") await handleClose();
      else if (
        (event.key === "ArrowRight" || event.key === "d") &&
        isLightboxOpen
      ) {
        event.preventDefault();
        navigateLightBox(1);
      } else if (
        (event.key === "ArrowLeft" || event.key === "a") &&
        isLightboxOpen
      ) {
        event.preventDefault();
        navigateLightBox(-1);
      }
    });

    // Aplicar observer a todos los sliders mobile
    sliders.forEach(slider => {
      if (slider) {
        const sliderItems = Array.from(slider.children);
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.style.transform = entry.isIntersecting
                ? "scale(1)"
                : "scale(0.8)";
            });
          },
          { root: slider, threshold: 0.9 }
        );

        sliderItems.forEach((item) => observer.observe(item));
      }
    });
  }

  document.addEventListener("DOMContentLoaded", bindGallery);
  document.addEventListener("astro:page-load", bindGallery);
  document.addEventListener("astro:after-swap", bindGallery);
</script>

<style>
  .title {
    position: absolute;
    color: #de96a1;
    animation: heartBeat 3s ease-in-out infinite;
  }
  @keyframes heartBeat {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.08);
    }
  }

  /* Aplicar scrollbar-width a todos los sliders */
  [id$="-slider-mobile"], #slider-mobile {
    scrollbar-width: none;
  }

  [id$="-slider-mobile"]::-webkit-scrollbar, #slider-mobile::-webkit-scrollbar {
    display: none;
  }
</style>
