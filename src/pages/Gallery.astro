---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { galleryImages } from "@/consts/galleryImages";
import { galleryBottles } from "@/consts/galleryBottles";
import { galleryPotatoes } from "@/consts/galleryPotatoes";
import { gallerySigns } from "@/consts/gallerySigns";
import { galleryNutellas } from "@/consts/galleryNutellas";
import { galleryChocolates } from "@/consts/galleryChocolates";
import { galleryCans } from "@/consts/galleryCans";

import LogoDecorazon from "../assets/logoDcorazon.png";
---

<Layout>
  <section class="bg-tertiary relative py-30 md:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl" id="gallery">
      <div class="relative mb-12 flex items-center justify-center">
        <Image
          class="md:hidden mx-auto inline-block h-auto rounded-full w-[200px] relative bottom-20"
          src={LogoDecorazon}
          alt="Logo Decorazon"
        />
        <h2
          class="title mb-2 block p-4 text-center text-[1.65rem] font-bold text-white sm:text-sm lg:text-4xl xl:text-5xl"
        >
          Galería De'Corazón
        </h2>
      </div>
      <h3
        class="block pb-20 text-center text-lg font-bold text-neutral-800/80 opacity-80 max-md:px-6 max-md:pb-5"
      >
        Echa un vistazo a algunos de nuestros trabajos recientes y déjate
        inspirar para tu próximo evento.
      </h3>

      <!-- Galería General Mobile -->
      <ul
        id="slider-mobile"
        class="flex snap-x snap-mandatory overflow-x-auto p-10 md:hidden [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          galleryImages.map(({ image, alt, thumb }, index) => (
            <li
              class="-m-1 aspect-9/10 w-72 shrink-0 cursor-pointer snap-center rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              id={thumb + "slider"}
              data-index={index}
              data-category="general"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "slider"}
                data-category="general"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Galería General Desktop -->
      <ul
        class="hidden grid-cols-1 gap-8 sm:grid-cols-2 md:grid md:grid-cols-3 lg:grid-cols-4 [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(n)]:hover:scale-105 [&>*:nth-child(n)]:hover:rotate-0 [&>*:nth-child(n)]:hover:shadow-xl [&>*:nth-child(odd)]:rotate-[-2deg]"
        id="general-gallery"
      >
        {
          galleryImages.map(({ image, alt, thumb }, index) => (
            <li
              id={thumb}
              class="aspect-9/10 cursor-pointer rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              data-index={index}
              data-category="general"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb}
                data-category="general"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Botellas Personalizadas -->
      <div id="galleryBottles" class="scroll-mt-[120px] relative mt-20 mb-12 flex items-center justify-center">
        <h2
          class="title mb-2 block p-4 text-center text-[1.65rem] font-bold text-white sm:text-sm lg:text-4xl xl:text-5xl"
        >
          Botellas Personalizadas
        </h2>
      </div>

      <!-- Botellas Mobile -->
      <ul
        id="bottles-slider-mobile"
        class="flex snap-x snap-mandatory overflow-x-auto p-10 md:hidden [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          galleryBottles.map(({ image, alt, thumb }, index) => (
            <li
              class="-m-1 aspect-9/10 w-72 shrink-0 cursor-pointer snap-center rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              id={thumb + "-bottles-slider"}
              data-index={index}
              data-category="bottles"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "-bottles-slider"}
                data-category="bottles"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Botellas Desktop -->
      <ul
        class="hidden grid-cols-1 gap-8 sm:grid-cols-2 md:grid md:grid-cols-3 lg:grid-cols-4 mb-20 [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(n)]:hover:scale-105 [&>*:nth-child(n)]:hover:rotate-0 [&>*:nth-child(n)]:hover:shadow-xl [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          galleryBottles.map(({ image, alt, thumb }, index) => (
            <li
              id={thumb + "-bottles"}
              class="aspect-9/10 cursor-pointer rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              data-index={index}
              data-category="bottles"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "-bottles"}
                data-category="bottles"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Papas Personalizadas -->
      <div id="galleryPotatoes" class="scroll-mt-[120px] relative mt-20 mb-12 flex items-center justify-center">
        <h2
          class="title mb-2 block p-4 text-center text-[1.65rem] font-bold text-white sm:text-sm lg:text-4xl xl:text-5xl"
        >
          Papas Personalizadas
        </h2>
      </div>

      <!-- Papas Mobile -->
      <ul
        id="potatoes-slider-mobile"
        class="flex snap-x snap-mandatory overflow-x-auto p-10 md:hidden [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          galleryPotatoes.map(({ image, alt, thumb }, index) => (
            <li
              class="-m-1 aspect-9/10 w-72 shrink-0 cursor-pointer snap-center rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              id={thumb + "-potatoes-slider"}
              data-index={index}
              data-category="potatoes"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "-potatoes-slider"}
                data-category="potatoes"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Papas Desktop -->
      <ul
        class="hidden grid-cols-1 gap-8 sm:grid-cols-2 md:grid md:grid-cols-3 lg:grid-cols-4 mb-20 [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(n)]:hover:scale-105 [&>*:nth-child(n)]:hover:rotate-0 [&>*:nth-child(n)]:hover:shadow-xl [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          galleryPotatoes.map(({ image, alt, thumb }, index) => (
            <li
              id={thumb + "-potatoes"}
              class="aspect-9/10 cursor-pointer rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              data-index={index}
              data-category="potatoes"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "-potatoes"}
                data-category="potatoes"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Carteles y Manteles -->
      <div id="gallerySigns" class="scroll-mt-[120px] relative mt-20 mb-12 flex items-center justify-center">
        <h2
          class="title mb-2 block p-4 text-center text-[1.65rem] font-bold text-white sm:text-sm lg:text-4xl xl:text-5xl"
        >
          Carteles y Manteles
        </h2>
      </div>

      <!-- Carteles Mobile -->
      <ul
        id="signs-slider-mobile"
        class="flex snap-x snap-mandatory overflow-x-auto p-10 md:hidden [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          gallerySigns.map(({ image, alt, thumb }, index) => (
            <li
              class="-m-1 aspect-9/10 w-72 shrink-0 cursor-pointer snap-center rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              id={thumb + "-signs-slider"}
              data-index={index}
              data-category="signs"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "-signs-slider"}
                data-category="signs"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Carteles Desktop -->
      <ul
        class="hidden grid-cols-1 gap-8 sm:grid-cols-2 md:grid md:grid-cols-3 lg:grid-cols-4 mb-20 [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(n)]:hover:scale-105 [&>*:nth-child(n)]:hover:rotate-0 [&>*:nth-child(n)]:hover:shadow-xl [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          gallerySigns.map(({ image, alt, thumb }, index) => (
            <li
              id={thumb + "-signs"}
              class="aspect-9/10 cursor-pointer rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              data-index={index}
              data-category="signs"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "-signs"}
                data-category="signs"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Nutellas Personalizadas -->
      <div id="galleryNutellas" class="scroll-mt-[120px] relative mt-20 mb-12 flex items-center justify-center">
        <h2
          class="title mb-2 block p-4 text-center text-[1.65rem] font-bold text-white sm:text-sm lg:text-4xl xl:text-5xl"
        >
          Nutellas Personalizadas
        </h2>
      </div>

      <!-- Nutellas Mobile -->
      <ul
        id="nutellas-slider-mobile"
        class="flex snap-x snap-mandatory overflow-x-auto p-10 md:hidden [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          galleryNutellas.map(({ image, alt, thumb }, index) => (
            <li
              class="-m-1 aspect-9/10 w-72 shrink-0 cursor-pointer snap-center rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              id={thumb + "-nutellas-slider"}
              data-index={index}
              data-category="nutellas"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "-nutellas-slider"}
                data-category="nutellas"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Nutellas Desktop -->
      <ul
        class="hidden grid-cols-1 gap-8 sm:grid-cols-2 md:grid md:grid-cols-3 lg:grid-cols-4 mb-20 [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(n)]:hover:scale-105 [&>*:nth-child(n)]:hover:rotate-0 [&>*:nth-child(n)]:hover:shadow-xl [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          galleryNutellas.map(({ image, alt, thumb }, index) => (
            <li
              id={thumb + "-nutellas"}
              class="aspect-9/10 cursor-pointer rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              data-index={index}
              data-category="nutellas"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "-nutellas"}
                data-category="nutellas"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Chocolatinas -->
      <div id="galleryChocolates" class="scroll-mt-[120px] relative mt-20 mb-12 flex items-center justify-center">
        <h2
          class="title mb-2 block p-4 text-center text-[1.65rem] font-bold text-white sm:text-sm lg:text-4xl xl:text-5xl"
        >
          Chocolatinas Personalizadas
        </h2>
      </div>

      <!-- Chocolatinas Mobile -->
      <ul
        id="chocolates-slider-mobile"
        class="flex snap-x snap-mandatory overflow-x-auto p-10 md:hidden [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          galleryChocolates.map(({ image, alt, thumb }, index) => (
            <li
              class="-m-1 aspect-9/10 w-72 shrink-0 cursor-pointer snap-center rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              id={thumb + "-chocolates-slider"}
              data-index={index}
              data-category="chocolates"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "-chocolates-slider"}
                data-category="chocolates"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Chocolatinas Desktop -->
      <ul
        class="hidden grid-cols-1 gap-8 sm:grid-cols-2 md:grid md:grid-cols-3 lg:grid-cols-4 mb-20 [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(n)]:hover:scale-105 [&>*:nth-child(n)]:hover:rotate-0 [&>*:nth-child(n)]:hover:shadow-xl [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          galleryChocolates.map(({ image, alt, thumb }, index) => (
            <li
              id={thumb + "-chocolates"}
              class="aspect-9/10 cursor-pointer rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              data-index={index}
              data-category="chocolates"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "-chocolates"}
                data-category="chocolates"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Latas Personalizadas -->
      <div id="galleryCans" class="scroll-mt-[120px] relative mt-20 mb-12 flex items-center justify-center">
        <h2
          class="title mb-2 block p-4 text-center text-[1.65rem] font-bold text-white sm:text-sm lg:text-4xl xl:text-5xl"
        >
          Latas Personalizadas
        </h2>
      </div>

      <!-- Latas Mobile -->
      <ul
        id="cans-slider-mobile"
        class="flex snap-x snap-mandatory overflow-x-auto p-10 md:hidden [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          galleryCans.map(({ image, alt, thumb }, index) => (
            <li
              class="-m-1 aspect-9/10 w-72 shrink-0 cursor-pointer snap-center rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              id={thumb + "-cans-slider"}
              data-index={index}
              data-category="cans"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "-cans-slider"}
                data-category="cans"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>

      <!-- Latas Desktop -->
      <ul
        class="hidden grid-cols-1 gap-8 sm:grid-cols-2 md:grid md:grid-cols-3 lg:grid-cols-4 mb-20 [&>*:nth-child(even)]:rotate-2 [&>*:nth-child(n)]:hover:scale-105 [&>*:nth-child(n)]:hover:rotate-0 [&>*:nth-child(n)]:hover:shadow-xl [&>*:nth-child(odd)]:rotate-[-2deg]"
      >
        {
          galleryCans.map(({ image, alt, thumb }, index) => (
            <li
              id={thumb + "-cans"}
              class="aspect-9/10 cursor-pointer rounded-md shadow-sm transition-transform duration-300 will-change-transform"
              data-index={index}
              data-category="cans"
            >
              <Image
                src={image}
                alt={alt}
                width={950}
                height={900}
                data-thumbID={thumb + "-cans"}
                data-category="cans"
                class="border-theme-blue-light h-full w-full rounded-md border border-dashed object-cover"
                loading="lazy"
              />
            </li>
          ))
