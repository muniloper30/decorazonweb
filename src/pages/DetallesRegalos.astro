          </div>
        </div>

        <!-- Main Content Area -->
        <div class="lg:w-3/4">
          <div class="bg-white rounded-2xl shadow-lg p-8">
            
            <!-- Tazas y Botellas Section -->
            <div id="section-tazas-botellas" class="content-section">
              <h2 class="text-3xl font-bold text-gray-800 mb-6">☕ Tazas y Botellas Personalizadas</h2>
              <p class="text-lg text-gray-600 mb-8">
                Transformamos tazas y botellas en regalos únicos y personalizados. Perfectas para cualquier ocasión especial, 
                desde cumpleaños hasta aniversarios. Cada pieza es diseñada con amor y atención al detalle.
              </p>
              
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                <div class="aspect-w-16 aspect-h-12 rounded-2xl shadow-lg overflow-hidden transition duration-700 ease-out transform hover:scale-105 hover:shadow-2xl">
                  <div class="w-full h-64 bg-gray-100 rounded-2xl flex items-center justify-center">
                    <img src="/src/assets/galleryBottles/bottles_01.webp" alt="Botella personalizada 1" class="object-cover w-full h-full" />
                  </div>
                </div>
                <div class="aspect-w-16 aspect-h-12 rounded-2xl shadow-lg overflow-hidden transition duration-700 ease-out transform hover:scale-105 hover:shadow-2xl">
