---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { serviceGallery } from "@/consts/serviceGallery";
---

<Layout>
  <section class="py-1 bg-gradient-to-b from-tertiary/100 to-white">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mt-20 mb-10">
        <h1 class="text-5xl font-bold text-gray-800 mb-6">Montajes de Mesas</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Transformamos tus eventos con montajes únicos y creativos. Desde
          celebraciones íntimas hasta grandes eventos, tenemos el montaje
          perfecto para cada ocasión.
        </p>
      </div>
    </div>
  </section>

  <!-- Tamaños de Montaje -->
  <section class="py-20 bg-white">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-800 mb-4">
          Tamaños de Montaje
        </h2>
        <p class="text-lg text-gray-600">
          Elige el tamaño perfecto para tu evento
        </p>
      </div>

      <!-- Primera fila: Montajes XS, S, M -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">

 <!-- Montaje XS -->
        <div
          class="bg-white rounded-2xl shadow-lg overflow-hidden
            transition duration-700 ease-out transform
            hover:scale-150 hover:shadow-2xl"
        >
          <div class="aspect-w-19 aspect-h-12">
            <Image
              src={serviceGallery[0].image}
              alt={serviceGallery[0].alt}
              class="object-cover w-full h-full"
            />
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-gray-800 mb-3">Montaje XS</h3>
            <p class="text-gray-600 mb-4">
             El Montaje XS es un set de decoración para eventos, perfecto para espacios pequeños, 
             que incluye 1 panel (mucha gente lo utiliza como photocall) y 1 sola mesa. <br /><br />
           Precio desde 150€ (no incluye papelería, (gasolina aparte dependiendo de la ubicación del evento)).
            </p>
          </div>
        </div>

        <!-- Montaje S -->
        <div
          class="bg-white rounded-2xl shadow-lg overflow-hidden
            transition duration-700 ease-out transform
            hover:scale-150 hover:shadow-2xl"
        >
          <div class="aspect-w-19 aspect-h-12">
            <Image
              src={serviceGallery[1].image}
              alt={serviceGallery[1].alt}
              class="object-cover w-full h-full"
            />
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-gray-800 mb-3">Montaje S</h3>
            <p class="text-gray-600 mb-4">
              El Montaje S es un set de decoración para eventos, perfecto para
              espacios reducidos, que incluye aro/paneles para photocall y hasta
              3 mesas. <br /><br />
              Precio 200€ (no incluye papelería, (Si el evento es fuera
              de Las Palmas +20€ de gasolina)).
            </p>
          </div>
        </div>

        <!-- Montaje M -->
        <div
          class="bg-white rounded-2xl shadow-lg overflow-hidden
            transition duration-700 ease-out transform
            hover:scale-150 hover:shadow-2xl"
        >
          <div class="aspect-w-16 aspect-h-12">
            <Image
                src={serviceGallery[2].image}
                alt={serviceGallery[2].alt}
              class="object-cover w-full h-full"
            />
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-gray-800 mb-3">Montaje M</h3>
            <p class="text-gray-600 mb-4">
              El Montaje M es una set de decoración para eventos, de 2 a 3
              metros de largo, que incluye paneles, globos, suelo, 2 figuras
              grandes y decoración con papelería. Se incluyen también 6 unidades
              de 6 tipos de snacks. <br /><br />
              Precio 250€ (Si el evento es fuera de Las Palmas +20€ de gasolina).
            </p>
          </div>
        </div>

      </div>

      <!-- Segunda fila: Montajes XL y con Globos centrados -->
      <div class="flex justify-center">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">


          <!-- Montaje L -->
        <div
          class="bg-white rounded-2xl shadow-lg overflow-hidden
            transition duration-700 ease-out transform
            hover:scale-150 hover:shadow-2xl"
        >
          <div class="aspect-w-16 aspect-h-12">
            <Image
              src={serviceGallery[3].image}
              alt={serviceGallery[3].alt}
              class="object-cover w-full h-full"
            />
          </div>
          <div class="p-6">
            <h3 class="text-2xl font-bold text-gray-800 mb-3">Montaje L</h3>
            <p class="text-gray-600 mb-4">
              El Montaje L es un set de decoración de 4 a 5 metros que incluye
              paneles, globos, suelo, 3 figuras grandes y decoración con
              papelería. También se incluyen 8 unidades de 7 tipos de snacks. <br
              />
              <br />

              Precio 350€ (Si el evento es fuera de Las Palmas +20€ de
              gasolina).
            </p>
          </div>
        </div>


          <!-- Montaje XL -->
          <div
            class="bg-white rounded-2xl shadow-lg overflow-hidden
              transition duration-700 ease-out transform
              hover:scale-150 hover:shadow-2xl"
          >
            <div class="aspect-w-12 aspect-h-10">
              <Image
                src={serviceGallery[4].image}
                alt={serviceGallery[4].alt}
                class="object-cover w-full h-full"
              />
            </div>
            <div class="p-6">
              <h3 class="text-2xl font-bold text-gray-800 mb-3">Montaje XL</h3>
              <p class="text-gray-600 mb-4">
                El Montaje XL es un set de decoración de 5 a 6 metros que
                incluye paneles, globos, suelo, 4 figuras grandes y decoración
                con papelería. Se añaden recordatorios para invitados y 10-12
                unidades de 7 tipos de snacks <br />
                <br />
                Precio 450€ (Si el evento es fuera de Las Palmas +20€ de gasolina).
              </p>
            </div>
          </div>

          <!-- Montaje con Globos -->
          <div
            class="bg-white rounded-2xl shadow-lg overflow-hidden
              transition duration-700 ease-out transform
              hover:scale-150 hover:shadow-2xl"
          >
            <div class="aspect-[16/12] w-full overflow-hidden">
              <Image
                src={serviceGallery[5].image}
                alt={serviceGallery[5].alt}
                class="object-cover w-full h-full"
              />
            </div>
            <div class="p-6">
              <h3 class="text-2xl font-bold text-gray-800 mb-3">
                Montaje con Globos
              </h3>
              <p class="text-gray-600 mb-4">
                Decoración especial con globos de colores y formas únicas.
              </p>
              <ul class="text-sm text-gray-500 space-y-1">
                <li>• Globos decorativos</li>
                <li>• Arcos de globos</li>
                <li>• Combinación colorida</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-gradient-to-b from-primary/5 to-white">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    
    <!-- Contenedor Principal Flex -->
    <div class="flex flex-col lg:flex-row gap-16 lg:gap-24 items-stretch justify-center">
      
      <!-- ================= MESAS INFANTILES ================= -->
      <div class="flex-1 flex flex-col w-full group">
        
        <!-- Título Superior -->
        <div class="mb-8">
          <h2 class="text-3xl lg:text-4xl font-light text-gray-800 mb-3 tracking-tight">
            Mesas <span class="font-bold">Infantiles</span>
          </h2>
          <p class="text-gray-500 font-light text-lg">
            Espacios mágicos diseñados especialmente para los más pequeños.
          </p>
        </div>

        <!-- Imagen (h-auto evita que se corte) -->
        <div class="mb-8 rounded-2xl shadow-sm transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-xl overflow-hidden bg-white/50">
          <Image
            src={serviceGallery[6].image}
            alt={serviceGallery[6].alt}
            class="w-full h-auto rounded-2xl"
          />
        </div>

        <!-- Contenido -->
        <div class="flex-1 flex flex-col">
          <h3 class="text-xl font-semibold text-gray-800 mb-4">
            Hacemos realidad la fiesta de tus sueños
          </h3>
          <p class="text-gray-600 font-light mb-8 leading-relaxed">
            Nuestras mesas infantiles están diseñadas para crear momentos mágicos e inolvidables. Cada detalle está pensado para que los niños disfruten al máximo de su celebración.
          </p>
          
          <!-- Lista de características minimalista -->
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-6 mt-auto">
            <li class="flex items-center text-gray-600 font-light">
              <svg class="w-5 h-5 text-primary mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Temáticas personalizadas
            </li>
            <li class="flex items-center text-gray-600 font-light">
              <svg class="w-5 h-5 text-primary mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Colores vibrantes
            </li>
            <li class="flex items-center text-gray-600 font-light">
              <svg class="w-5 h-5 text-primary mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Elementos interactivos
            </li>
            <li class="flex items-center text-gray-600 font-light">
              <svg class="w-5 h-5 text-primary mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Decoración segura
            </li>
          </ul>
        </div>
      </div>

      <!-- ================= MESAS DULCES Y SALADOS ================= -->
      <div class="flex-1 flex flex-col w-full group">
        
        <!-- Título Superior -->
        <div class="mb-8">
          <h2 class="text-3xl lg:text-4xl font-light text-gray-800 mb-3 tracking-tight">
            Mesas <span class="font-bold">Dulces y Salados</span>
          </h2>
          <p class="text-gray-500 font-light text-lg">
            Una explosión de sabores y detalles para deleitar a tus invitados.
          </p>
        </div>

        <!-- Imagen (h-auto evita que se corte) -->
        <div class="mb-8 rounded-2xl shadow-sm transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-xl overflow-hidden bg-white/50">
          <Image
            src={serviceGallery[7].image}
            alt={serviceGallery[7].alt}
            class="w-full h-auto rounded-2xl"
          />
        </div>

        <!-- Contenido -->
        <div class="flex-1 flex flex-col">
          <h3 class="text-xl font-semibold text-gray-800 mb-4">
            Diseño exclusivo para tu paladar
          </h3>
          <p class="text-gray-600 font-light mb-8 leading-relaxed">
            Nuestras mesas combinan la mejor repostería con opciones saladas gourmet. Cuidamos cada textura y presentación para conseguir un buffet irresistible y a medida.
          </p>
          
          <!-- Lista de características minimalista -->
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-y-4 gap-x-6 mt-auto">
            <li class="flex items-center text-gray-600 font-light">
              <svg class="w-5 h-5 text-primary mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Variedad gourmet
            </li>
            <li class="flex items-center text-gray-600 font-light">
              <svg class="w-5 h-5 text-primary mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Presentación elegante
            </li>
            <li class="flex items-center text-gray-600 font-light">
              <svg class="w-5 h-5 text-primary mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Opciones personalizadas
            </li>
            <li class="flex items-center text-gray-600 font-light">
              <svg class="w-5 h-5 text-primary mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Ingredientes frescos
            </li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>

  <!-- CTA Section -->
  <section class="py-20 bg-primary">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="text-4xl font-bold text-white mb-6">
        ¿Listo para tu próximo evento?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Contacta con nosotros y crearemos el montaje perfecto para tu
        celebración
      </p>
      <a
        href="/Form"
        class="inline-block bg-white text-primary px-8 py-4 rounded-xl font-semibold text-lg hover:bg-gray-500 hover:text-white transition-colors duration-300 shadow-lg"
      >
        Solicitar Presupuesto
      </a>
    </div>
  </section>
</Layout>
