---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { ViewTransitions } from "astro:transitions";
import ScrollToTop from "@/components/ScrollToTop.astro";
Astro.props;

const {
  title = "De'corazón | Decoración y Organización de eventos ",
  preloadImage,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="En De Corazón creemos que cada celebración es una oportunidad para crear momentos que perduren. 
      Nuestra ilusión es transformar tus ideas en experiencias únicas, llenas de magia y detalles pensados con cariño."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- LCP Optimizations -->
    {
      preloadImage && (
        <link
          rel="preload"
          href={preloadImage}
          as="image"
          fetchpriority="high"
        />
      )
    }
    <link
      rel="preload"
      href="/fonts/amertha.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
  </head>
  <body class="w-screen overflow-x-hidden">
    <ScrollToTop />
    <Header />
    <ViewTransitions />
    <slot />
  </body>
</html>
